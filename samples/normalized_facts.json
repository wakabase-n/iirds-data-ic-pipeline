    {
      "rule_id": "3.1",
      "section_title": "3.1 Power-Up Sequence",
      "raw_text": "During the power-up sequence, VCC must reach a stable voltage within 10ms. The Chip Enable signal (CE#) must remain High (VIH) until VCC reaches the minimum operating voltage of 2.7V. If VCC drops below 2.2V (Brown-out state), the internal reset circuit is activated immediately to prevent data corruption.",
      "fact_elements": {
        "trigger_signal": "Power-up sequence / Brown-out state (< 2.2V)",
        "target_component": "Internal reset circuit / CE# / VCC",
        "required_value": "VCC >= 2.7V, CE# = VIH",
        "duration": "within 10ms"
      },
      "text_keywords": [
        "power-up sequence",
        "Brown-out state",
        "data corruption",
        "internal reset circuit"
      ]
    },
    {
      "rule_id": "Rule #101",
      "section_title": "3.2 Interlock and Safety Exceptions",
      "raw_text": "When the applied voltage on VCC exceeds 3.6V, the internal controller shall issue a protection lock and disable all Write/Erase operations.",
      "fact_elements": {
        "trigger_signal": "VCC > 3.6V",
        "target_component": "Internal controller / Write/Erase operations",
        "required_value": "Protection lock / Disable Write/Erase",
        "duration": null
      },
      "text_keywords": [
        "protection lock",
        "disable Write/Erase operations",
        "Over-voltage Protection"
      ]
    },
    {
      "rule_id": "Rule #102",
      "section_title": "3.2 Interlock and Safety Exceptions",
      "raw_text": "When Error Code E-404 (Over-current / Motor Overload Signal) is asserted by the host system, AUX_PWR must remain supplied at 5.0V for at least 30 seconds to complete the internal safe-discharge sequence. Opening the module cover or cutting AUX_PWR before 30 seconds have elapsed may cause permanent electrical damage to the microbump array.",
      "fact_elements": {
        "trigger_signal": "Error Code E-404",
        "target_component": "AUX_PWR",
        "required_value": "5.0V",
        "duration": ">= 30 seconds"
      },
      "text_keywords": [
        "permanent electrical damage",
        "safe-discharge sequence",
        "Error Code E-404"
      ]
    }
